      "parameters": {
        "jsCode": "const trig = $('Build Message: Month Setup (1st 06:00)').first().json;\nconst monthKey = $now.toFormat('yyyy-LL');\nconst n = $('Build Month Lines').all().length;\nreturn [{ json: { chat_id: trig.chat_id, agent_name: 'month_setup', chatInput: trig.chatInput ?? 'AUTOMATIC MONTH SETUP', output: 'Budget ' + monthKey + ' is ready: ' + n + ' budget lines created from the default budgets.' } }];"
      }
