    {
      "id": "build-lines",
      "name": "Build Month Lines",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1120,
        2528
      ],
      "parameters": {
        "jsCode": "const txt = (a) => (a || []).map(t => t.plain_text).join('');\nconst monthKey = $now.toFormat('yyyy-LL');\nconst monthStart = $now.startOf('month').toISODate();\nconst pagesOf = (n) => $(n).all().map(i => i.json).filter(p => p && p.properties);\nconst cats = pagesOf('Fetch Categories For Month Setup').map(pg => ({\n  id: pg.id, name: txt(pg.properties['Name'] && pg.properties['Name'].title),\n  def: pg.properties['Default Monthly Budget (PLN)'] ? pg.properties['Default Monthly Budget (PLN)'].number : null\n}));\nconst lines = pagesOf('Fetch Lines For Month Setup').map(pg => {\n  const p = pg.properties;\n  return { month: p['Month'] && p['Month'].date ? p['Month'].date.start.slice(0, 7) : null,\n           catId: p['Category'] && p['Category'].relation && p['Category'].relation[0] ? p['Category'].relation[0].id : null,\n           budget: p['Budget (PLN)'] ? p['Budget (PLN)'].number : null,\n           budgetEur: p['Budget (EUR)'] && p['Budget (EUR)'].number > 0 ? p['Budget (EUR)'].number : null };\n});\nconst existing = new Set(lines.filter(l => l.month === monthKey && l.catId).map(l => l.catId));\nconst overallExists = lines.some(l => l.month === monthKey && !l.catId);\nconst out = [];\nfor (const c of cats) {\n  if (c.def != null && c.def > 0 && !existing.has(c.id)) out.push({ json: { name: c.name + ' – ' + monthKey, month: monthStart, catId: c.id, budget: c.def, budgetEur: null } });\n}\nif (!overallExists) {\n  const prev = lines.filter(l => !l.catId && l.month && l.month < monthKey && l.budget != null).sort((a, b) => (a.month < b.month ? 1 : -1))[0];\n  // A cap set in euros is carried over in euros; the Coach recalculates its PLN value at the current rate\n  if (prev) out.push({ json: { name: 'Overall – ' + monthKey, month: monthStart, catId: '', budget: prev.budget, budgetEur: prev.budgetEur } });\n}\nreturn out;"
      }
    },
