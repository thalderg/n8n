    {
      "id": "wf4-extract",
      "name": "Extract Owner",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1264,
        1184
      ],
      "parameters": {
        "jsCode": "const PRIMARY_OWNER = 'YOUR_NAME'; // your own owner: tag; you get the priority alerts already\nconst workflowData = $input.first().json;\nconst tags = workflowData.tags || [];\nconst ownerTag = tags.find(t => t.name?.startsWith('owner:'));\nconst owner = ownerTag ? ownerTag.name.replace('owner:', '') : null;\nconst isPrimaryOwner = !owner || owner === PRIMARY_OWNER;\nconst originalPayload = $('Normalize & Classify').first().json;\nreturn [{ json: { ...originalPayload, detectedOwner: owner, isPrimaryOwner: isPrimaryOwner } }];"
      }
    },
