    {
      "id": "s4-pickA",
      "name": "Pick Customers For Win-Back Email",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "onError": "stopWorkflow",
      "position": [
        1024,
        576
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const s = $('Store Settings').first().json;\nconst cooldown = Date.now() - s.winback_cooldown_days * 86400000;\nconst out = [];\nfor (const item of $input.all()) {\n  const r = item.json;\n  if (!r.email) continue;\n  const state = r.winback_state || '';\n  const lastDone = r.winback_last_completed ? new Date(r.winback_last_completed).getTime() : 0;\n  if ((state === '' || state === 'done') && (!lastDone || lastDone < cooldown)) out.push({ json: r });\n}\nreturn out;"
      }
    },
