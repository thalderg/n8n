      "parameters": {
        "resource": "row",
        "operation": "get",
        "dataTableId": {
          "__rl": true,
          "mode": "id",
          "value": "YOUR_CUSTOMERS_DATA_TABLE_ID"
        },
        "matchType": "allConditions",
        "returnAll": true,
        "filters": {
          "conditions": [
            {
              "keyName": "last_order_date",
              "condition": "lt",
