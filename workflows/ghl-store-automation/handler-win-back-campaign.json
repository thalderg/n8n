        "language": "javaScript",
        "jsCode": "const s = $('Store Settings').first().json;\nconst cutoff = Date.now() - s.winback_sms_gap_days * 86400000;\nconst out = [];\nfor (const item of $input.all()) {\n  const r = item.json;\n  if (!r.email || r.winback_state !== 'email_sent' || !r.winback_started_at) continue;\n  const started = new Date(r.winback_started_at).getTime();\n  const lastOrder = r.last_order_date ? new Date(r.last_order_date).getTime() : 0;\n  if (started <= cutoff && lastOrder < started) out.push({ json: r });\n}\nreturn out;"
