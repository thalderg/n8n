    {
      "id": "l-decide",
      "name": "Decide Opportunity Action",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2080,
        464
      ],
      "parameters": {
        "jsCode": "const input = $('GHL Settings').first().json;\nconst contact = $('Create Or Update GHL Contact').first().json || {};\nconst RANK = { new_lead: 1, contacted: 2, cart_created: 3, purchased: 4, repeat_customer: 5 };\nconst stageIds = {\n  new_lead: input.stage_id_new_lead,\n  contacted: input.stage_id_contacted,\n  cart_created: input.stage_id_cart_created,\n  purchased: input.stage_id_purchased,\n  repeat_customer: input.stage_id_repeat_customer,\n};\nconst keyById = Object.fromEntries(Object.entries(stageIds).map(([k, v]) => [v, k]));\nconst opps = ($input.first().json.opportunities || []).filter(o => !o.pipelineId || o.pipelineId === input.pipeline_id);\nconst opp = opps[0];\nconst target = input.target_stage || 'none';\nconst targetRank = RANK[target] || 0;\nconst stageBefore = opp ? (keyById[opp.pipelineStageId] || 'unknown') : 'none';\nconst currentRank = RANK[stageBefore] || 0;\nlet action = 'skip';\nif (targetRank > 0) {\n  if (!opp) action = 'create';\n  else if (targetRank > currentRank) action = 'update';\n}\nconst stageApplied = action === 'skip' ? stageBefore : target;\nconst tags = new Set(contact.tags || []);\n(input.add_tags || []).forEach(t => tags.add(t));\n(input.remove_tags || []).forEach(t => tags.delete(t));\nreturn [{ json: {\n  action,\n  contact_id: contact.id,\n  opportunity_id: opp ? opp.id : '',\n  stage_before: stageBefore,\n  stage_applied: stageApplied,\n  target_stage_id: stageIds[target] || '',\n  tags_final: [...tags],\n  order_value: input.order_value ?? null,\n  customer_name: [input.first_name, input.last_name].filter(Boolean).join(' ') || input.email,\n} }];"
      }
