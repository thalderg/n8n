{
  "id": "ghlAdaptMock0001",
  "name": "[GHL Store Automation] | GHL Adapter (Mock)",
  "nodes": [
    {
      "id": "n-switch",
      "name": "Route By Adapter Action",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.4,
      "position": [
        304,
        404
      ],
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict",
                  "version": 2
                },
                "conditions": [
                  {
                    "id": "c1",
                    "leftValue": "={{ $json.action }}",
                    "rightValue": "upsert_stage",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "upsert_stage"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict",
                  "version": 2
                },
                "conditions": [
                  {
                    "id": "c2",
                    "leftValue": "={{ $json.action }}",
                    "rightValue": "send_sms",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "send_sms"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "n-find",
      "name": "Find Mock Contact By Email",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "alwaysOutputData": true,
      "position": [
        624,
        384
      ],
      "parameters": {
        "operation": "get",
        "dataTableId": {
          "__rl": true,
          "mode": "id",
          "value": "YOUR_MOCK_CONTACTS_DATA_TABLE_ID"
        },
        "matchType": "allConditions",
        "filters": {
          "conditions": [
            {
              "keyName": "email",
              "keyValue": "={{ $json.email }}"
            }
          ]
        },
        "limit": 1
      }
    },
    {
      "id": "n-merge",
      "name": "Merge Tags And Decide Stage",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        384
      ],
      "parameters": {
        "jsCode": "const input = $('Receive Adapter Call').first().json;\nconst found = $input.first().json || {};\nconst RANK = { new_lead: 1, contacted: 2, cart_created: 3, purchased: 4, repeat_customer: 5 };\nconst existing = Boolean(found.email);\nconst stageBefore = existing && found.stage ? found.stage : 'none';\nconst currentRank = RANK[stageBefore] || 0;\nconst target = input.target_stage || 'none';\nconst targetRank = RANK[target] || 0;\nconst stageApplied = targetRank > currentRank ? target : stageBefore;\nconst tags = new Set((found.tags || '').split(',').map(t => t.trim()).filter(Boolean));\nfor (const t of (input.add_tags || [])) tags.add(t);\nfor (const t of (input.remove_tags || [])) tags.delete(t);\nconst contactId = found.contact_id || ('mock-' + Buffer.from(String(input.email)).toString('hex'));\nreturn [{ json: { email: input.email, contact_id: contactId, stage_before: stageBefore, stage_applied: stageApplied, target_stage: target, tags_final: [...tags], tags_csv: [...tags].join(','), run_id: input.run_id || '' } }];"
      }
    },
    {
      "id": "n-save",
      "name": "Save Mock Contact",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [
        1152,
        384
      ],
      "parameters": {
        "operation": "upsert",
        "dataTableId": {
          "__rl": true,
          "mode": "id",
          "value": "YOUR_MOCK_CONTACTS_DATA_TABLE_ID"
        },
        "matchType": "allConditions",
        "filters": {
          "conditions": [
            {
              "keyName": "email",
              "keyValue": "={{ $json.email }}"
            }
          ]
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "email": "={{ $json.email }}",
            "contact_id": "={{ $json.contact_id }}",
            "stage": "={{ $json.stage_applied }}",
            "tags": "={{ $json.tags_csv }}"
          },
          "matchingColumns": [
            "email"
          ],
          "schema": []
        },
        "options": {}
      }
    },
    {
      "id": "n-logstage",
      "name": "Log Mock Stage Change",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [
        1408,
        384
      ],
      "parameters": {
        "dataTableId": {
          "__rl": true,
          "mode": "id",
          "value": "YOUR_MOCK_LOG_DATA_TABLE_ID"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "ts": "={{ $now.toISO() }}",
            "run_id": "={{ $('Merge Tags And Decide Stage').first().json.run_id }}",
            "kind": "stage",
            "email": "={{ $('Merge Tags And Decide Stage').first().json.email }}",
            "detail": "={{ JSON.stringify({ stage_before: $('Merge Tags And Decide Stage').first().json.stage_before, stage_applied: $('Merge Tags And Decide Stage').first().json.stage_applied, target_stage: $('Merge Tags And Decide Stage').first().json.target_stage, tags: $('Merge Tags And Decide Stage').first().json.tags_final }) }}"
          },
          "matchingColumns": [],
          "schema": []
        },
        "options": {}
      }
    },
    {
      "id": "n-outup",
      "name": "Build Upsert Output",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        1664,
        384
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "a1",
              "name": "ok",
              "value": true,
              "type": "boolean"
            },
            {
              "id": "a2",
              "name": "contact_id",
              "value": "={{ $('Merge Tags And Decide Stage').first().json.contact_id }}",
              "type": "string"
            },
            {
              "id": "a3",
              "name": "opportunity_id",
              "value": "={{ 'opp-' + $('Merge Tags And Decide Stage').first().json.contact_id }}",
              "type": "string"
            },
            {
              "id": "a4",
              "name": "stage_before",
              "value": "={{ $('Merge Tags And Decide Stage').first().json.stage_before }}",
              "type": "string"
            },
            {
              "id": "a5",
              "name": "stage_applied",
              "value": "={{ $('Merge Tags And Decide Stage').first().json.stage_applied }}",
              "type": "string"
            },
            {
              "id": "a6",
              "name": "tags_final",
              "value": "={{ $('Merge Tags And Decide Stage').first().json.tags_final }}",
              "type": "array"
            },
            {
              "id": "a7",
