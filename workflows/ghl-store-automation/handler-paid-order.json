    {
      "id": "s3-decide",
      "name": "Decide First Or Repeat Purchase",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "onError": "stopWorkflow",
      "position": [
        784,
        460
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const ev = $('Store Settings').first().json;\nconst row = $input.first().json || {};\nconst previousOrders = Number(row.order_count || 0);\nconst repeat = previousOrders >= 1 || Number(ev.prior_order_count || 0) >= 1;\nreturn [{ json: { ...ev, target_stage: repeat ? 'repeat_customer' : 'purchased', new_order_count: Math.max(previousOrders, Number(ev.prior_order_count || 0)) + 1 } }];"
      }
    },
