            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Ask Backup Model (Venice)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Ask Backup Model (Venice)": {
      "main": [
        [
          {
            "node": "Read Answer",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "saveManualExecutions": true,
    "saveDataErrorExecution": "all",
    "saveDataSuccessExecution": "all",
    "errorWorkflow": "",
