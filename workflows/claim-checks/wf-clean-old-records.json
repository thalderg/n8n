    {
      "id": "73ed46bb-c7c6-4aa6-b4ee-dec18c2a86a9",
      "name": "Build Targets",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        520,
        860
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Why Code: builds one Airtable filter per kind of row from the keep times in Store Settings. Keywords are never in this list.\nconst s = $('Store Settings').first().json;\nconst older = (days) => `IS_BEFORE(CREATED_TIME(), DATEADD(NOW(), -${Number(days)}, 'days'))`;\nconst base = { airtable_base: s.airtable_base, keywords_table: s.keywords_table, count_only: s.count_only === true };\nreturn [\n  { name: 'Findings, dropped posts', table: s.findings_table, keep_days: s.keep_dropped_posts_days, formula: `AND(NOT({kept}), ${older(s.keep_dropped_posts_days)})` },\n  { name: 'Findings, kept posts', table: s.findings_table, keep_days: s.keep_kept_posts_days, formula: `AND({kept}, ${older(s.keep_kept_posts_days)})` },\n  { name: 'Clusters', table: s.clusters_table, keep_days: s.keep_clusters_days, formula: older(s.keep_clusters_days) },\n  { name: 'Runs', table: s.runs_table, keep_days: s.keep_runs_days, formula: older(s.keep_runs_days) },\n].map(t => ({ json: { ...base, ...t } }));"
      }
    },
    {
      "id": "f1ae1f36-9996-495e-a30e-53705b493189",
      "name": "Loop Over Kinds Of Rows",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [
        740,
        860
