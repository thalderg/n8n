      "id": "9eea05d1-171f-48be-86db-cbe895a73bbe",
      "name": "Clean One Table (via this workflow)",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2,
      "position": [
        960,
        1000
      ],
      "parameters": {
        "source": "database",
        "workflowId": {
          "__rl": true,
          "mode": "id",
          "value": "={{ $workflow.id }}"
        },
        "mode": "once",
        "options": {
          "waitForSubWorkflow": true
        }
      }
    },
    {
      "id": "79e2e61a-e46d-4334-a3e9-c5bcc84c44ce",
      "name": "Build Clean Summary",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1180,
        860
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Why Code: one line per kind of row for the execution log (found, deleted).\nconst r = $input.all().map(i => i.json);\nconst found = r.reduce((n, x) => n + (x.found || 0), 0), deleted = r.reduce((n, x) => n + (x.deleted || 0), 0);\nreturn [{ json: { found, deleted, count_only: r.some(x => x.count_only), by_kind: r.map(x => `${x.name}: ${x.found} older than ${x.keep_days} days, ${x.deleted} deleted`) } }];"
      }
    },
    {
      "id": "bdc54307-193c-4c2c-a26d-b60ad618dac9",
      "name": "When Called By This Workflow",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        60,
        1720
      ],
      "parameters": {
        "inputSource": "passthrough"
      }
    },
    {
      "id": "9f0c3bdc-d066-4fe2-93e1-451c3ecd3ebc",
      "name": "Find Old Rows (Airtable)",
      "notesInFlow": true,
      "notes": "All pages of one table, 100 rows each.",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000,
      "position": [
        300,
        1720
      ],
      "parameters": {
        "method": "GET",
        "url": "=https://api.airtable.com/v0/{{ $json.airtable_base }}/{{ $json.table }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "airtableTokenApi",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "filterByFormula",
              "value": "={{ $json.formula }}"
            },
            {
              "name": "pageSize",
              "value": "100"
            },
            {
              "name": "fields[]",
              "value": "run_id"
            }
          ]
        },
        "options": {
          "timeout": 30000,
          "pagination": {
            "pagination": {
              "paginationMode": "updateAParameterInEachRequest",
              "parameters": {
                "parameters": [
                  {
                    "type": "qs",
                    "name": "offset",
                    "value": "={{ $response.body.offset }}"
                  }
                ]
              },
              "paginationCompleteWhen": "other",
              "completeExpression": "={{ !$response.body.offset }}",
              "limitPagesFetched": true,
              "maxRequests": 100,
              "requestInterval": 250
            }
          }
        }
      },
      "credentials": {
        "airtableTokenApi": {
          "id": "REPLACE_WITH_YOUR_CREDENTIAL_ID",
          "name": "Airtable"
        }
      }
    },
    {
      "id": "57104eb6-73a3-47e7-8f56-76c644ae2618",
      "name": "Build Delete Batches",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        520,
        1720
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Why Code: joins the pages of this one table and cuts the rows into deletes of 10 (Airtable's maximum per request).\nconst t = $('When Called By This Workflow').first().json;\nif (t.table === t.keywords_table) throw new Error('The Keywords table must never be cleaned');\nconst ids = [...new Set($input.all().flatMap(i => (i.json.records || []).map(r => r.id)))];\nconst out = [];\nfor (let i = 0; i < ids.length; i += 10) out.push({ json: { url: `https://api.airtable.com/v0/${t.airtable_base}/${t.table}?` + ids.slice(i, i + 10).map(x => 'records[]=' + x).join('&'), found: ids.length } });\nreturn out.length ? out : [{ json: { none: true, found: 0 } }];"
      }
    },
    {
      "id": "949b8232-bdf8-4888-ae31-832b0a76646a",
      "name": "Delete Or Only Count?",
      "notesInFlow": true,
      "notes": "Old rows and count_only off: delete. Else: nothing deleted.",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        740,
        1720
      ],
      "parameters": {
        "looseTypeValidation": true,
        "options": {},
        "conditions": {
          "options": {
            "version": 2,
            "leftValue": "",
            "caseSensitive": true,
            "typeValidation": "loose"
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "7277ee0d-433e-444b-93e1-5b5b1ee36d57",
              "leftValue": "={{ $('When Called By This Workflow').first().json.count_only !== true && $json.none !== true }}",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              },
              "rightValue": ""
            }
          ]
        }
      }
    },
    {
