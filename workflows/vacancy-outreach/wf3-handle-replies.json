    {
      "id": "870c9a31-068c-5177-81f7-ad726ab5b9c0",
      "name": "Find Lead For Thread",
      "notesInFlow": true,
      "notes": "Keeps only replies in a thread we started. Others end here.",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1080,
        820
      ],
      "parameters": {
        "jsCode": "const leads = $('Read Leads').all().map(i => i.json).filter(l => l.thread_id);\n// Reply ids already handled per lead: from the reply_ids column, plus the ones taken in this run.\nconst handled = {};\nconst interestedSeen = {};\nconst out = [];\n// Gmail's preview has HTML codes (&lt;) and the quoted history: keep a clean, short version for Telegram.\nconst decode = s => s.replace(/&lt;/g, '<').replace(/&gt;/g, '>').replace(/&quot;/g, '\"').replace(/&#39;/g, \"'\").replace(/&amp;/g, '&');\nconst newPart = s => s.split(/\\s*(?:-{3,}\\s*Original Message|\\bOn [^\\n]{3,80}?wrote:?|Sent (?:from|with) Proton Mail|Sent from my )/)[0].trim();\nfor (const it of $('Receive Reply Email').all()) {\n  const m = it.json;\n  const lead = leads.find(l => String(l.thread_id) === String(m.threadId));\n  if (!lead || lead.status === 'stopped' || !m.id) continue;\n  const key = String(lead.lead_id);\n  if (!handled[key]) handled[key] = String(lead.reply_ids || '').split(',').map(s => s.trim()).filter(Boolean);\n  // A copy the Gmail trigger sends again has the same id: skip it.\n  if (handled[key].includes(m.id)) continue;\n  handled[key].push(m.id);\n  const firstInterested = lead.reply_label !== 'interested' && !interestedSeen[key];\n  interestedSeen[key] = true;\n  out.push({ json: Object.assign({}, lead, {\n    reply_text: decode(String(m.text || m.snippet || '')).slice(0, 1500),\n    reply_short: (newPart(decode(String(m.text || m.snippet || ''))) || decode(String(m.text || m.snippet || ''))).slice(0, 400),\n    reply_from: m.From || m.from || '',\n    reply_message_id: m.id,\n    reply_ids_new: handled[key].join(','),\n    first_interested: firstInterested,\n  }) });\n}\nreturn out;",
        "mode": "runOnceForAllItems"
      }
    },
    {
      "id": "47765021-348c-5f35-8caf-0935a43baef9",
      "name": "Build Reply Label Request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1340,
        820
      ],
      "parameters": {
        "jsCode": "const S = $('Build Settings Object').first().json;\nconst schema = { type: 'object', additionalProperties: false, required: ['label', 'reason', 'suggested_reply'],\n  properties: { label: { type: 'string', enum: ['interested', 'not_now', 'unsubscribe', 'out_of_office'] }, reason: { type: 'string' }, suggested_reply: { type: 'string' } } };\nconst system = `<role>\nYou read one reply to a cold email and label it.\n</role>\n<seller>\nSender name: ${S.sender_name}\nCompany: ${S.sender_company}\nWhat we sell: ${S.what_we_sell}\nTone: ${S.tone}\n</seller>\n<rules>\n1. interested: the person wants profiles, information, a call or asks a question about the offer.\n2. unsubscribe: the person asks to stop, to be removed, or not to be contacted. Also words like STOP or unsubscribe. If in doubt between unsubscribe and any other label, choose unsubscribe.\n3. out_of_office: an automatic reply about absence.\n4. not_now: a polite no, or not at this time.\n5. suggested_reply: only for interested. 40 to 70 words, plain text. Greet the contact by first name. Answer only what was asked. The input has the job post (company, role, description) and our first email: use those facts and never ask for anything already in them (the trade, the role, the location, the company). Ask at most one question, only about something they do not say (for example how many people or the start date), or offer a short call. Sign with the sender name. Make no promise about people, prices or dates. For every other label write an empty string.\n6. reason: one short sentence.\n</rules>\n<example>\n  <input>{\"reply\":\"Thanks, we are fully staffed until spring.\"}</input>\n  <output>{\"label\":\"not_now\",\"reason\":\"Polite no for now.\",\"suggested_reply\":\"\"}</output>\n</example>\nThe example only shows the shape of an answer: never reuse its content.`;\nreturn $input.all().map(it => ({ json: { lead: it.json, request: { model: 'z-ai-glm-5-3-flash', temperature: 0, max_tokens: 3000, reasoning_effort: 'low',\n  messages: [{ role: 'system', content: system }, { role: 'user', content: JSON.stringify({ job: { company: it.json.company, role: it.json.job_title, description: it.json.job_description, contact_name: it.json.contact_name }, our_first_email: String(it.json.email_body || '').slice(0, 1500), reply: it.json.reply_text }) }],\n  response_format: { type: 'json_schema', json_schema: { name: 'reply_label', strict: true, schema } } } } }));",
        "mode": "runOnceForAllItems"
      }
    },
    {
      "id": "68229817-8dca-5076-9918-fa709d32b979",
      "name": "Label Reply (Venice)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000,
      "position": [
        1600,
        820
      ],
      "parameters": {
        "method": "POST",
        "url": "https://api.venice.ai/api/v1/chat/completions",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "openAiApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.request) }}",
        "options": {
          "timeout": 90000
        }
      },
      "credentials": {
        "openAiApi": {
          "name": "Venice API (OpenAI-compatible)"
        }
      }
    },
    {
      "id": "ddc901ef-af9a-5c47-a381-e9fe008d2ff4",
      "name": "Read Reply Label",
      "notesInFlow": true,
      "notes": "Fails when the answer is cut off or not valid JSON.",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1860,
        820
      ],
      "parameters": {
        "jsCode": "const req = $('Build Reply Label Request').all();\nconst out = [];\n$input.all().forEach((it, i) => {\n  const r = it.json;\n  const ch = r.choices && r.choices[0];\n  if (!ch || ch.finish_reason !== 'stop' || !ch.message || !ch.message.content) {\n    throw new Error('Reply label answer cut off or empty (finish_reason: ' + (ch && ch.finish_reason) + ')');\n  }\n  let o;\n  try { o = JSON.parse(ch.message.content); } catch (e) { throw new Error('Reply label answer is not valid JSON'); }\n  out.push({ json: Object.assign({}, req[i].json.lead, { answer: o }) });\n});\nreturn out;",
        "mode": "runOnceForAllItems"
      }
    },
