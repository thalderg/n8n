    {
      "id": "a1d798c0-20e9-570b-9cac-e0758f5021da",
      "name": "Build Settings Object",
      "notesInFlow": true,
      "notes": "Turns the key/value rows into one settings object with safe defaults.",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        560,
        820
      ],
      "parameters": {
        "jsCode": "const rows = $input.all().map(i => i.json);\nconst s = {};\nfor (const r of rows) { if (r.key) s[String(r.key).trim()] = (r.value === undefined || r.value === null) ? '' : String(r.value).trim(); }\nconst num = (v, d) => { const n = Number(v); return (String(v).trim() !== '' && Number.isFinite(n)) ? n : d; };\nreturn [{ json: {\n  what_we_sell: s.what_we_sell || '',\n  who_buys: s.who_buys || '',\n  signal_titles: (s.signal_titles || '').split(',').map(x => x.trim()).filter(Boolean),\n  source_mode: (s.source_mode || 'sample').toLowerCase(),\n  location: s.location || '',\n  skip_recruiters: (s.skip_recruiters || 'yes').toLowerCase() === 'yes',\n  max_post_age_days: num(s.max_post_age_days, 45),\n  min_score: num(s.min_score, 4),\n  daily_cap: num(s.daily_cap, 5),\n  approval_mode: (s.approval_mode || 'on').toLowerCase(),\n  sender_name: s.sender_name || '',\n  sender_company: s.sender_company || '',\n  postal_address: s.postal_address || '',\n  tone: s.tone || ''\n} }];",
        "mode": "runOnceForAllItems"
      }
    },
