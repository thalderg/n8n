    {
      "id": "0fce10ff-d1bc-524c-a1f2-313f83eb8730",
      "name": "Choose Emails To Send Today",
      "notesInFlow": true,
      "notes": "Ready leads up to the cap, follow-up 1 after 3 days, follow-up 2 after 7 days. Skips suppressed contacts.",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1340,
        820
      ],
      "parameters": {
        "jsCode": "const S = $('Build Settings Object').first().json;\nconst leads = $('Read Leads').all().map(i => i.json).filter(r => r.lead_id && r.contact_email);\nconst supp = $('Read Suppression List').all().map(i => i.json);\nconst sEmails = new Set(supp.map(r => String(r.email || '').toLowerCase()).filter(Boolean));\nconst sDomains = new Set(supp.map(r => String(r.domain || '').toLowerCase()).filter(Boolean));\nconst dayNum = (s) => { const p = String(s).slice(0, 10).split('-').map(Number); return Date.UTC(p[0], p[1] - 1, p[2]) / 86400000; };\n// Today's date in the workflow time zone (WF2 Settings, Timezone), so day counts match the market.\nconst todayStr = $now.toFormat('yyyy-MM-dd');\nconst daysSince = (d) => dayNum(todayStr) - dayNum(d);\nconst esc = (t) => String(t).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\nconst html = (t) => String(t).split(/\\n\\n+/).map(p => '<p>' + esc(p).replace(/\\n/g, '<br>') + '</p>').join('');\nconst footer = '\\n\\n--\\n' + S.sender_name + '\\n' + S.sender_company + '\\n' + S.postal_address + '\\nReply STOP and I will not write again.';\nconst out = [];\nlet firstCount = 0;\nfor (const l of leads) {\n  const email = String(l.contact_email).toLowerCase();\n  const dom = String(l.domain || '').toLowerCase();\n  if (sEmails.has(email) || (dom && sDomains.has(dom))) continue;\n  let action = null;\n  if (l.status === 'ready') { if (firstCount < S.daily_cap) { action = 'email1'; firstCount++; } }\n  else if (l.status === 'sent' && l.sent_date && daysSince(l.sent_date) >= 3) action = 'followup1';\n  else if (l.status === 'followup1' && l.sent_date && daysSince(l.sent_date) >= 7) action = 'followup2';\n  if (!action) continue;\n  const first = String(l.contact_name || '').split(' ')[0] || 'there';\n  const role = String(l.job_title || '').split(';')[0].trim();\n  let subject = l.email_subject, text = l.email_body;\n  if (action === 'followup1') { subject = 'Re: ' + l.email_subject; text = 'Hi ' + first + ',\\n\\nA short follow-up on my note about the open ' + role + ' role at ' + l.company + '. If it helps, I can send two or three profiles.\\n\\n' + S.sender_name + footer; }\n  if (action === 'followup2') { subject = 'Re: ' + l.email_subject; text = 'Hi ' + first + ',\\n\\nLast note from me on the ' + role + ' role. If the timing is not right, no problem, I will not write again.\\n\\n' + S.sender_name + footer; }\n  out.push({ json: Object.assign({}, l, { action, expected_messages: action === 'followup1' ? 1 : 2, send_subject: subject, send_html: html(text), today: todayStr }) });\n}\nreturn out;",
        "mode": "runOnceForAllItems"
      }
    },
